      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', messages: [ { role: 'system', content: $json.prompt }, { role: 'user', content: $('Webhook').item.json.body.chatInput } ], temperature: 0.7, max_tokens: 2048, top_p: 0.9 }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-request-groq-003",
      "name": "HTTP Request1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ekstrak jawaban dari response Groq API\nconst groqResponse = $input.first().json;\n\nlet output = '';\n\ntry {\n  if (groqResponse.choices && groqResponse.choices.length > 0) {\n    output = groqResponse.choices[0].message.content || '';\n  } else if (groqResponse.error) {\n    output = `Error dari Groq: ${groqResponse.error.message || JSON.stringify(groqResponse.error)}`;\n  } else {\n    output = 'Maaf, tidak ada respons dari AI. Coba lagi.';\n  }\n} catch (e) {\n  output = `Error memproses respons: ${e.message}`;\n}\n\n// Bersihkan markdown formatting yang tidak diinginkan\noutput = output\n  .replace(/\\*\\*/g, '')     // hapus bold markdown\n  .replace(/##\\s*/g, '')    // hapus heading markdown\n  .replace(/__/g, '')       // hapus underscore markdown\n  .replace(/\\*/g, '')       // hapus italic markdown\n  .trim();\n\nreturn [{ json: { output } }];"
      },
      "id": "code-node-004",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        340
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ output: $json.output }) }}",
        "options": {}
      },
